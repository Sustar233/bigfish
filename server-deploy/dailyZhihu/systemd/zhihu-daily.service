[Unit]
Description=Generate bilingual Zhihu daily
Wants=network-online.target codex-proxy.service
After=network-online.target codex-proxy.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/dailyZhihu
ExecStart=/usr/bin/python3 /home/ubuntu/dailyZhihu/server_runner.py
TimeoutStartSec=90min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/dailyZhihu
ReadWritePaths=/home/ubuntu/.codex
MemoryMax=1G
CPUQuota=100%
