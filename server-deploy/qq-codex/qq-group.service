[Unit]
Description=Bounded three-member QQ group chat
Wants=network-online.target codex-proxy.service qq-account.service qq-dsh-account.service
After=network-online.target codex-proxy.service qq-account.service qq-dsh-account.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qq-group/workspace
ExecStart=/usr/bin/python3 /home/ubuntu/qq-codex/bridge/group_chat.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/qq-group /home/ubuntu/.dsh /home/ubuntu/.codex /home/ubuntu/qq-codex/bridge/.private/records /home/ubuntu/qq-dsh/records
MemoryMax=1G
TasksMax=192
KillMode=control-group

[Install]
WantedBy=multi-user.target
