[Unit]
Description=Private QQ archive collection and metadata-only health alerts
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qq-codex/bridge
ExecStart=/usr/bin/python3 /home/ubuntu/qq-codex/bridge/qq_maintenance.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/qq-memory /home/ubuntu/qq-dsh/records /home/ubuntu/qq-codex/bridge/.private/records
MemoryMax=256M
TimeoutStartSec=110
