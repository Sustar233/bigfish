[Unit]
Description=Owner-only QQ native Codex image jobs
After=network-online.target codex-proxy.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/server-maintenance/images
ExecStart=/usr/bin/python3 /home/ubuntu/server-maintenance/images/image_service.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/server-maintenance/images/.private /home/ubuntu/.codex /home/ubuntu/server-maintenance/usage/data
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
